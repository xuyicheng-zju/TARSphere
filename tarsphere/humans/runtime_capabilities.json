        "seat_interact_offset"
      ],
      "backend_command": "Sit",
      "animation_clips": ["Sit"],
      "llm_example": {"action": "sit", "seat_anchor": "living room sofa"}
    },
    {
      "name": "queue",
      "description": "Join an authored ordered queue and optionally leave it.",
      "required_parameters": ["queue_name", "spots"],
      "optional_parameters": ["first_action", "leave_target", "leave_rot"],
      "prerequisites": ["baked_navmesh", "reachable_queue_spots"],
