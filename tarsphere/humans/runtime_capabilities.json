        "stand_idle_loop",
        "stand_idle_loop_mirror",
        "stand_walk_loop",
        "stand_walk_loop_mirror"
      ],
      "llm_example": {
        "action": "queue",
        "queue_name": "CounterLine",
        "spots": [[1.0, 2.0, 0.0, 0.0]]
      }
    },
    {
