      "optional_parameters": ["partner_human_id"],
      "prerequisites": ["actual_operation_stance", "completed_body_motion"],
      "backend_command": "",
      "animation_clips": [],
      "llm_example": {"action": "perform_task", "target_anchor": "kitchen_stove_stance", "task_description": "Start the stove for the planned preparation."}
    },
    {
      "name": "ask",
