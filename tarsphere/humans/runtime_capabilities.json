      "optional_parameters": [],
      "prerequisites": [],
      "backend_command": "",
      "animation_clips": [],
      "llm_example": {"action": "ask", "message": "Could you clarify what you need?"}
    },
    {
      "name": "speak",
      "description": "Make a public statement through the language channel.",
