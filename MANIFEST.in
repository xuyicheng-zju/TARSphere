# A source release must support the same setup and evaluation as a checkout.
include LICENSE README.md README.zh-CN.md CITATION.cff CONTRIBUTING.md SECURITY.md
include environment.yml pytest.ini .editorconfig .gitattributes .gitignore
graft .github
graft assets
graft docs
graft episodes
graft examples
graft extensions
graft scripts
graft tests
graft third_party
prune assets/models
prune assets/robots
prune assets/demo
prune assets/benchmark
recursive-exclude third_party ext/*checkpoints*/*
global-exclude __pycache__ *.py[cod] .DS_Store *.log *.pid *.sock
global-exclude *.pt *.pth *.ckpt *.safetensors
global-exclude .git .gitignore.local .env host_env.sh
