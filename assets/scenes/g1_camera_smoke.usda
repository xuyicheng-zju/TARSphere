#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def DomeLight "Light"
    {
        float inputs:intensity = 1000
    }

    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.45, 0.45, 0.45)]
        double3 xformOp:translate = (0, 0, -0.05)
        double3 xformOp:scale = (30, 30, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "RedTarget"
    {
        double size = 0.5
        color3f[] primvars:displayColor = [(0.9, 0.05, 0.05)]
        double3 xformOp:translate = (2, -0.8, 1.1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cube "GreenTarget"
    {
        double size = 0.5
        color3f[] primvars:displayColor = [(0.05, 0.9, 0.05)]
        double3 xformOp:translate = (2, 0, 1.1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cube "BlueTarget"
    {
        double size = 0.5
        color3f[] primvars:displayColor = [(0.05, 0.05, 0.9)]
        double3 xformOp:translate = (2, 0.8, 1.1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
